{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SaInT8888888888/corrlog/corrlog_core/schema/acr-v1.json",
  "title": "ACR v1 record family: action, correction, uncertainty",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "correctionId",
    "agent",
    "principal",
    "timestamp",
    "signature"
  ],
  "properties": {
    "correctionId": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "publicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "principal": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string"
        }
      }
    },
    "supersedes": {
      "type": "object",
      "required": [
        "receiptId",
        "digest"
      ],
      "properties": {
        "receiptId": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "object",
          "required": [
            "alg",
            "digest"
          ],
          "properties": {
            "alg": {
              "const": "sha256"
            },
            "digest": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          }
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string"
        }
      }
    },
    "reason": {
      "type": "string"
    },
    "trigger": {
      "type": "string",
      "enum": [
        "supersede",
        "check_failed",
        "human_flagged",
        "self_correction"
      ]
    },
    "fix": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "replace",
            "delete",
            "rollback",
            "noop",
            "other"
          ]
        },
        "contentHash": {
          "type": "object",
          "required": [
            "alg",
            "digest"
          ],
          "properties": {
            "alg": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "minLength": 16
            }
          }
        },
        "note": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "required": [
            "type",
            "reference"
          ],
          "properties": {
            "type": {
              "enum": [
                "schema",
                "document",
                "database",
                "api",
                "human",
                "other"
              ]
            },
            "reference": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "object",
      "required": [
        "alg",
        "kid",
        "canonicalization",
        "sig",
        "publicKey"
      ],
      "properties": {
        "alg": {
          "type": "string",
          "const": "Ed25519"
        },
        "kid": {
          "type": "string",
          "minLength": 1
        },
        "publicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "canonicalization": {
          "type": "string",
          "const": "RFC8785"
        },
        "sig": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    },
    "metadata": {
      "type": "object"
    },
    "kind": {
      "enum": [
        "action",
        "correction",
        "unknown"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "unknown"
          }
        }
      },
      "then": {
        "required": [
          "subject"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "supersedes"
              ]
            },
            {
              "required": [
                "fix"
              ]
            },
            {
              "required": [
                "action"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "not": {
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "unknown"
            }
          }
        }
      },
      "then": {
        "required": [
          "action",
          "reason",
          "trigger",
          "fix"
        ]
      }
    },
    {
      "if": {
        "required": [
          "supersedes"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "minLength": 1
          },
          "kind": {
            "const": "correction"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "correction"
          }
        }
      },
      "then": {
        "required": [
          "supersedes"
        ]
      }
    },
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "action"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "supersedes"
          ]
        }
      }
    }
  ]
}
